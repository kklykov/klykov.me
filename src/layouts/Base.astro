---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { defaultLocale, type Locale } from '../i18n/config';
import { alternatesFor } from '../i18n/routes';
import { t } from '../i18n/ui';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * Ruta de esta página en cada idioma. Por defecto, la misma ruta traducida.
   * Si falta un idioma, no se anuncia con hreflang y el selector lleva a su portada.
   * Sin la del idioma actual (p. ej. en la 404), no hay canónica.
   */
  alternates?: Partial<Record<Locale, string>>;
  /** Sin cabecera: páginas a pantalla completa que traen su propia navegación. */
  header?: boolean;
  /** Tipo para Open Graph: las notas son "article". */
  type?: 'website' | 'article';
}

const lang = (Astro.currentLocale ?? defaultLocale) as Locale;
const { title, description, alternates = alternatesFor(Astro.url.pathname), header = true, type = 'website' } = Astro.props;

const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = alternates[lang];
const languages = Object.entries(alternates) as [Locale, string][];
const xDefault = alternates[defaultLocale] ?? languages[0]?.[1];
const ui = t(lang);
const ogLocale: Record<Locale, string> = { es: 'es_ES', en: 'en_US' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Para compartir: una imagen por idioma (public/og/) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="klykov.me" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={absolute(canonical)} />}
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:image" content={absolute(`/og/${lang}.png`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui.home.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={absolute(canonical)} />}
    {
      languages.length > 1 && (
        <>
          {languages.map(([locale, path]) => (
            <link rel="alternate" hreflang={locale} href={absolute(path)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absolute(xDefault!)} />
        </>
      )
    }

    <Font cssVariable="--font-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{ui.skipToContent}</a>
    {header && <Header lang={lang} alternates={alternates} />}
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 10;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
  }

  .skip-link:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }
</style>
