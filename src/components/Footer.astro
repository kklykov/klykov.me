---
import { links } from '../data/links';
import type { Locale } from '../i18n/config';
import { parsePath, sectionUrl } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const ui = t(lang);
const onUses = parsePath(Astro.url.pathname).section === 'uses';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p>{ui.footer.madeWith} · {year}</p>
  <nav aria-label={ui.footer.label}>
    <ul role="list">
      <li><a class="tap" href={`mailto:${links.email[lang]}`}>{links.email[lang]}</a></li>
      <li><a class="tap" href={links.github}>GitHub</a></li>
      <li><a class="tap" href={links.linkedin}>LinkedIn</a></li>
      <li><a class="tap" href={sectionUrl('uses', lang)} aria-current={onUses ? 'page' : undefined}>/uses</a></li>
      <li><a class="tap" href={links.klykovCo}>klykov.co <span aria-hidden="true">↗</span></a></li>
    </ul>
  </nav>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 3rem;
    border-top: 1px solid var(--line);
    padding-top: clamp(2.5rem, 2.2809rem + 0.8989vw, 3rem); /* 40 → 48 */
    padding-bottom: max(clamp(3rem, 2.5618rem + 1.7978vw, 4rem), env(safe-area-inset-bottom)); /* 48 → 64 */
    padding-inline: var(--gutter-left) var(--gutter-right);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--text-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
  }

  a[aria-current] {
    color: var(--accent);
  }

  @media (min-width: 64rem) {
    .site-footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
