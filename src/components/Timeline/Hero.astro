---
import type { Locale } from '../../i18n/config';
import { homeUrl } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import LangSwitch from '../LangSwitch.astro';

interface Props {
  lang: Locale;
  alternates: Partial<Record<Locale, string>>;
}

const { lang, alternates } = Astro.props;
const ui = t(lang).home;
---

<section class="hero" aria-labelledby="hero-title">
  <header class="bar">
    <a class="brand tap" href={homeUrl(lang)} aria-current="page">klykov.me</a>
    <span class="tagline tagline-bar">{ui.tagline}</span>
    <LangSwitch lang={lang} alternates={alternates} />
  </header>

  <div class="main">
    <p class="tagline tagline-main">{ui.tagline}</p>
    <h1 id="hero-title">
      <span class="line"><span class="rise">{ui.title.line1}</span></span>
      <span class="line"><span class="rise">{ui.title.line2}<em>{ui.title.em}</em>{ui.title.end}</span></span>
    </h1>
    <p class="intro">{ui.intro}</p>
  </div>

  <a class="scroll" href="#capitulo-00">
    <span>{ui.scroll}<span class="visually-hidden"> {ui.scrollTo}</span> <span aria-hidden="true">↓</span></span>
  </a>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 100svh;
    /* La barra va donde la cabecera del resto de páginas: misma altura, tamaño y color. */
    padding: max(var(--header-pad-y), env(safe-area-inset-top)) var(--gutter-right) 2.5rem var(--gutter-left);
    font-family: var(--font-mono);
    font-size: var(--fs-nav);
    color: var(--text-muted);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    color: var(--text-muted);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--text);
  }

  .tagline-bar {
    display: none;
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tagline-main {
    font-size: var(--fs-small);
  }

  h1 {
    font-size: clamp(5.25rem, 1.7992rem + 14.1573vw, 13.125rem); /* 84 → 210 */
    line-height: 0.86;
    letter-spacing: -0.035em;
    color: var(--text);
    text-wrap: initial;
  }

  h1 span {
    display: block;
  }

  /* Entrada: el titular sube desde una máscara y el resto aparece. Solo transform y opacity. */
  .line {
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 1100ms var(--ease-out) both;
    }

    .line + .line .rise {
      animation-delay: 160ms;
    }

    .bar,
    .tagline-main,
    .intro,
    .scroll {
      animation: fade 1200ms ease both;
    }

    .intro,
    .scroll {
      animation-delay: 600ms;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  em {
    color: var(--accent);
  }

  /* "Desliza ↓": ancla al capítulo 00, con el estilo de los enlaces secundarios. */
  .scroll {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: var(--tap);
    color: var(--text-muted);
    text-decoration: none;
  }

  .scroll:hover {
    color: var(--text);
  }

  .intro {
    max-width: 28.75rem;
    font-family: var(--font-sans);
    font-size: clamp(1.0625rem, 0.9803rem + 0.3371vw, 1.25rem); /* 17 → 20 */
    line-height: 1.5;
  }

  /* Escritorio: el lema sube a la barra y la entradilla baja junto a "Desliza". */
  @media (min-width: 64rem) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto 1fr auto;
      grid-template-areas:
        'bar bar'
        'title title'
        'intro scroll';
      padding-bottom: 3rem;
    }

    .bar {
      grid-area: bar;
    }

    .tagline-bar {
      display: block;
    }

    .main {
      display: contents;
    }

    .tagline-main {
      display: none;
    }

    h1 {
      grid-area: title;
      align-self: center;
    }

    .intro {
      grid-area: intro;
      align-self: end;
    }

    .scroll {
      grid-area: scroll;
      align-self: end;
    }
  }
</style>
