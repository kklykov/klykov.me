---
// Un capítulo de la línea temporal. Completo y legible sin JS; la versión horizontal es una mejora.
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/config';
import { localize } from '../../i18n/localize';
import Wink from './Wink.astro';

interface Props {
  chapter: CollectionEntry<'timeline'>;
  lang: Locale;
}

const { chapter, lang } = Astro.props;
const { id, data } = chapter;
const titleId = `capitulo-${id}-t`;
// Sin fragmento de código (06), el texto va con el titular y el hueco de la derecha queda para el chat.
const textWithHeading = !data.snippet;
---

<section
  class="chapter"
  id={`capitulo-${id}`}
  data-chapter={id}
  data-font={data.font}
  data-code={data.code}
  data-name={data.title[lang].replace(/\n/g, ' ')}
  aria-labelledby={titleId}
>
  <span class="number" aria-hidden="true">{id}</span>
  {data.wink && <Wink wink={data.wink} lang={lang} />}

  <div class="content">
    <div class="heading">
      <p class="label"><span class="code">{data.code}</span> · {localize(data.year, lang)}</p>
      <h2 id={titleId}>{data.title[lang]}</h2>
      {textWithHeading && <p class="text">{data.text[lang]}</p>}
    </div>
    <div class="aside">
      {!textWithHeading && <p class="text">{data.text[lang]}</p>}
      {
        data.snippet && (
          <figure>
            {data.snippet.file && <figcaption class="visually-hidden">{data.snippet.file}</figcaption>}
            <pre tabindex="0"><code>{data.snippet.code.trimEnd()}</code></pre>
          </figure>
        )
      }
      <slot />
    </div>
  </div>
</section>

<style>
  /* Tamaños por capítulo: titular y número gigante de móvil (390px) a 1280px; en escritorio,
     --t y --n son sus medidas en el diseño, escaladas con --u. */
  [data-chapter='00'] {
    --title: clamp(4.5rem, 2.7472rem + 7.191vw, 8.5rem);
    --number: clamp(22.5rem, 11.5449rem + 44.9438vw, 47.5rem);
    --t: 136;
    --n: 760;
  }
  [data-chapter='01'] {
    --title: clamp(5.5rem, 3.802rem + 6.9663vw, 9.375rem);
    --number: clamp(22.5rem, 11.5449rem + 44.9438vw, 47.5rem);
    --t: 150;
    --n: 760;
  }
  [data-chapter='02'] {
    --title: clamp(4.5rem, 2.3638rem + 8.764vw, 9.375rem);
    --number: clamp(22.5rem, 15.927rem + 26.9663vw, 37.5rem);
    --t: 150;
    --n: 600;
  }
  [data-chapter='03'] {
    --title: clamp(6.5rem, 4.1447rem + 9.6629vw, 11.875rem);
    --number: clamp(22.5rem, 15.927rem + 26.9663vw, 37.5rem);
    --t: 190;
    --n: 600;
  }
  [data-chapter='04'] {
    --title: clamp(3.5rem, 2.1854rem + 5.3933vw, 6.5rem);
    --number: clamp(22.5rem, 15.927rem + 26.9663vw, 37.5rem);
    --t: 104;
    --n: 600;
  }
  [data-chapter='05'] {
    --title: clamp(4rem, 2.2472rem + 7.191vw, 8rem);
    --number: clamp(22.5rem, 14.8315rem + 31.4607vw, 40rem);
    --t: 128;
    --n: 640;
  }
  [data-chapter='06'] {
    --title: clamp(10rem, 7.809rem + 8.9888vw, 15rem);
    --number: clamp(22.5rem, 11.5449rem + 44.9438vw, 47.5rem);
    --t: 240;
    --n: 760;
  }

  .chapter {
    /* Alto de pantalla con las barras del navegador ocultas (lvh): al ocultarse no asoma el capítulo
       siguiente. Lo que ocupan las barras (--bars) va al margen inferior, así el contenido cabe con ellas (svh). */
    --bars: calc(100lvh - 100svh);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100lvh;
    padding: 4.5rem var(--gutter-right) calc(3rem + var(--bars)) var(--gutter-left);
  }

  .number {
    position: absolute;
    top: 2.5rem;
    right: -1.875rem;
    font-size: var(--number);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--outline);
    pointer-events: none;
    user-select: none;
  }

  .content,
  .heading,
  .aside {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .content {
    position: relative;
  }

  .label {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--text-muted);
  }

  .code {
    color: var(--accent);
  }

  h2 {
    font-size: var(--title);
    line-height: 0.9;
    white-space: pre-line;
    text-wrap: initial;
  }

  .text {
    font-size: clamp(1rem, 0.9452rem + 0.2247vw, 1.125rem); /* 16 → 18 */
    line-height: 1.6;
    color: var(--text-muted);
  }

  figure {
    margin: 0;
  }

  pre {
    overflow-x: auto;
    padding: 0.875rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    font-size: clamp(0.75rem, 0.7226rem + 0.1124vw, 0.8125rem); /* 12 → 13 */
    line-height: 1.6;
    color: var(--text);
  }

  /* Tipografía de cada época, en el titular y en el número gigante */
  [data-font='serif'] :is(h2, .number) {
    font-family: var(--font-serif);
    letter-spacing: -0.02em;
  }

  [data-font='times'] :is(h2, .number) {
    font-family: var(--font-times);
    line-height: 0.88;
  }

  [data-font='verdana'] :is(h2, .number) {
    font-family: var(--font-verdana);
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  [data-font='mono'] :is(h2, .number) {
    font-family: var(--font-mono);
  }

  [data-font='sans'] :is(h2, .number) {
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  [data-chapter='00'] :is(h2, .number) {
    font-style: italic;
  }

  [data-chapter='00'] .code {
    color: inherit;
  }

  [data-chapter='03'] h2 {
    letter-spacing: -0.04em;
  }

  [data-chapter='04'] h2 {
    line-height: 0.95;
    letter-spacing: 0.04em;
  }

  [data-chapter='04'] .number {
    letter-spacing: 0.1em;
  }

  /* 06 · IA: número en caramelo y cursor de escritura */
  [data-chapter='06'] h2 {
    line-height: 0.8;
    letter-spacing: -0.03em;
  }

  [data-chapter='06'] .number {
    -webkit-text-stroke-color: var(--accent);
    opacity: 0.3;
  }

  [data-chapter='06'] h2::after {
    content: '';
    display: inline-block;
    width: 0.08em;
    height: 0.72em;
    margin-left: 0.06em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .aside:empty {
    display: none;
  }

  /* Escritorio: medidas del diseño a 1280×800, escaladas con --u (docs/diseno.md). */
  @media (min-width: 64rem) {
    .chapter {
      --title: calc(var(--t) * var(--u));
      --number: calc(var(--n) * var(--u));
      padding: calc(120 * var(--u)) calc(96 * var(--u)) calc(96 * var(--u));
    }

    .number {
      top: calc(-20 * var(--u));
      right: calc(-60 * var(--u));
      transform-origin: center;
    }

    :is([data-chapter='00'], [data-chapter='01']) .number {
      top: calc(-40 * var(--u));
    }

    :is([data-chapter='03'], [data-chapter='04']) .number {
      right: calc(-80 * var(--u));
    }

    .content {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: calc(64 * var(--u));
    }

    .heading {
      gap: calc(16 * var(--u));
    }

    .label {
      font-size: calc(14 * var(--u));
    }

    .text {
      font-size: calc(18 * var(--u));
    }

    .aside {
      flex-shrink: 0;
      width: calc(380 * var(--u));
      gap: calc(20 * var(--u));
    }

    pre {
      padding: calc(16 * var(--u));
      border-radius: calc(10 * var(--u));
      font-size: calc(13 * var(--u));
      line-height: 1.65;
    }

    [data-chapter='06'] .number {
      top: calc(-40 * var(--u));
      left: calc(-40 * var(--u));
      right: auto;
    }

    [data-chapter='06'] .content {
      gap: calc(80 * var(--u));
    }

    [data-chapter='06'] .heading {
      gap: calc(20 * var(--u));
      max-width: calc(460 * var(--u));
    }

    [data-chapter='06'] .aside {
      width: calc(540 * var(--u));
    }
  }
</style>
