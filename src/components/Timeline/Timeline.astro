---
/**
 * Línea temporal de la portada, con la portada (slot "before") y el cierre (slot "after").
 * Sin JS (o con movimiento reducido) todo se apila en vertical. Con JS, `data-mode` elige la versión:
 * - "horizontal" (escritorio): un escenario anclado de una pantalla. El scroll real solo da el recorrido
 *   y los puntos del imán; portada, capítulos (en horizontal) y cierre se pintan desde él, con inercia.
 * - "vertical" (móvil, o escritorio con movimiento reducido): barra superior con índice desplegable.
 */
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';
import Chat from '../Chat/Chat.astro';
import Chapter from './Chapter.astro';

interface Props {
  chapters: CollectionEntry<'timeline'>[];
  lang: Locale;
}

const { chapters, lang } = Astro.props;
const ui = t(lang).home;
const nameOf = (chapter: CollectionEntry<'timeline'>) => chapter.data.title[lang].replace(/\n/g, ' ');
const first = chapters[0];
---

<div class="timeline" data-timeline data-go-to={ui.goTo} data-index-label={ui.index} data-konami-message={ui.konami}>
  <!-- Escritorio: puntos del imán (scroll-snap, sin JS): portada, un capítulo por pantalla y cierre -->
  {[...Array(chapters.length + 2).keys()].map((i) => <span class="snap" style={`--i: ${i}`} aria-hidden="true" />)}

  <div class="pin" data-pin>
    <div class="stage" data-stage>
      <slot name="before" />

      <div class="view" role="region" aria-label={ui.timeline} data-view>
        <!-- Móvil: barra fija con el capítulo actual y el índice -->
        <div class="mbar" data-mbar hidden>
          <div class="mbar-row">
            <span>klykov.me</span>
            <button
              type="button"
              class="mbar-toggle"
              aria-expanded="false"
              aria-controls="indice-capitulos"
              aria-label={ui.index.replace('{name}', nameOf(first))}
              data-index-toggle
            >
              <span class="code" data-current-code>{first.data.code}</span> — <span data-current-name>{nameOf(first)}</span>
              <span class="chevron" aria-hidden="true">▾</span>
            </button>
          </div>
          <div class="progress"><span data-progress></span></div>
          <nav id="indice-capitulos" class="index" aria-label={ui.chapters} hidden>
            <ul role="list">
              {
                chapters.map((chapter) => (
                  <li>
                    <a href={`#capitulo-${chapter.id}`} data-index-link>
                      <span class="code">{chapter.data.code}</span>
                      <span class="name">{nameOf(chapter)}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <!-- Escritorio: barra superior (decorativa: el estado lo anuncia el menú) -->
        <div class="dbar" aria-hidden="true">
          <span>klykov.me</span>
          <span><span class="code" data-current-code>{first.data.code}</span> — <span data-current-name>{nameOf(first)}</span></span>
        </div>

        <div class="track" data-track>
          {
            chapters.map((chapter) => (
              <Chapter chapter={chapter} lang={lang}>
                {chapter.id === '06' && <Chat lang={lang} />}
              </Chapter>
            ))
          }
        </div>

        <!-- Escritorio: menú inferior de capítulos -->
        <nav class="menu" aria-label={ui.chapters} data-menu hidden>
          <div class="progress"><span data-progress></span></div>
          <div class="ticks">
            {
              chapters.map((chapter, i) => (
                <button
                  type="button"
                  class="tick"
                  data-tick={i}
                  aria-label={ui.goTo.replace('{code}', chapter.id).replace('{name}', nameOf(chapter))}
                >
                  {chapter.id}
                  <span class="tick-name" aria-hidden="true">
                    {nameOf(chapter)}
                  </span>
                </button>
              ))
            }
          </div>
        </nav>
      </div>

      <slot name="after" />
    </div>
  </div>

  <p class="visually-hidden" role="status" aria-live="polite" data-konami-live></p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-timeline]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const $$ = <T extends Element>(sel: string) => [...root.querySelectorAll<T>(sel)];

    const stage = $<HTMLElement>('[data-stage]');
    const track = $<HTMLElement>('[data-track]');
    const chapters = $$<HTMLElement>('[data-chapter]');
    const numbers = chapters.map((c) => c.querySelector<HTMLElement>('.number')!);
    const contents = chapters.map((c) => c.querySelector<HTMLElement>('.content')!);
    const winks = chapters.map((c) => c.querySelector<HTMLElement>('[data-wink]'));
    const menu = $<HTMLElement>('[data-menu]');
    const ticks = $$<HTMLButtonElement>('[data-tick]');
    const mbar = $<HTMLElement>('[data-mbar]');
    const toggle = $<HTMLButtonElement>('[data-index-toggle]');
    const index = document.getElementById(toggle.getAttribute('aria-controls')!)!;
    const indexLinks = $$<HTMLAnchorElement>('[data-index-link]');
    const last = chapters.length - 1;

    const desktop = matchMedia('(min-width: 64rem)');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let mode: 'horizontal' | 'vertical' | undefined;
    let start = 0;
    let vw = innerWidth;
    let vh = innerHeight;
    let u = 1; // --u en px: la portada se diseña a 1280×800
    let tops: number[] = [];
    let current = -1;
    let frame = 0;
    let shown = scrollY; // scroll que se pinta: sigue al real con inercia (solo en horizontal)
    let lastTime = 0;

    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const pageTop = (el: Element) => el.getBoundingClientRect().top + scrollY;

    function measure() {
      vw = innerWidth;
      vh = innerHeight;
      u = Math.min(vw / 1280, vh / 800);
      start = pageTop(root);
      tops = chapters.map(pageTop);
    }

    function setCurrent(i: number) {
      if (i === current) return;
      current = i;
      const { code, name } = chapters[i].dataset;
      for (const el of $$('[data-current-code]')) el.textContent = code!;
      for (const el of $$('[data-current-name]')) el.textContent = name!;
      toggle.setAttribute('aria-label', root.dataset.indexLabel!.replace('{name}', name!));
      ticks.forEach((tick, t) => {
        tick.toggleAttribute('data-passed', t <= i);
        if (t === i) tick.setAttribute('aria-current', 'step');
        else tick.removeAttribute('aria-current');
      });
      indexLinks.forEach((link, l) => {
        if (l === i) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      });
    }

    function setProgress(p: number) {
      for (const bar of $$<HTMLElement>('[data-progress]')) bar.style.transform = `scaleX(${p})`;
    }

    // Inercia: shown += (scrollY − shown) × 0.085 por frame de 60 Hz (~0,9 s), igual a cualquier frecuencia.
    // El imán mueve el scroll real; esto solo suaviza lo que se pinta. Sin suavizado con movimiento reducido.
    function follow(time: number) {
      const target = scrollY;
      const frames = lastTime ? (time - lastTime) / (1000 / 60) : 1;
      shown = reduce.matches ? target : shown + (target - shown) * (1 - (1 - 0.085) ** frames);
      if (Math.abs(target - shown) < 0.5) shown = target;
      lastTime = shown === target ? 0 : time;
      return shown === target;
    }

    // Escritorio: el recorrido se mide en pantallas. Parada 0: portada; 1…7: capítulos 00…06; 8: cierre.
    const stopTop = (k: number) => start + k * vh;

    // Un solo bucle de requestAnimationFrame: se mantiene mientras el pintado no ha llegado al scroll real.
    function update(time: number) {
      frame = 0;
      if (mode === 'horizontal') {
        const arrived = follow(time);
        if (!arrived) frame = requestAnimationFrame(update);
        const at = (shown - start) / vh; // pantallas recorridas
        // El escenario (portada, capítulos y cierre en columna) sube al entrar y al salir de los capítulos.
        const lift = clamp(at) + clamp(at - 1 - last);
        stage.style.transform = lift ? `translate3d(0, ${-lift * vh}px, 0)` : '';
        // Capítulo pintado (0…6) y pista con translate3d(−pos × 100vw)
        const pos = Math.min(last, Math.max(0, at - 1));
        track.style.transform = `translate3d(${-pos * vw}px, 0, 0)`;
        // Parallax en tres capas: número detrás, guiño en medio y contenido delante.
        chapters.forEach((_, i) => {
          const local = pos - i;
          const d = Math.min(1, Math.abs(local));
          numbers[i].style.transform = `translateX(${local * 420 * u}px) scale(${1 - d * 0.12})`;
          if (winks[i]) winks[i].style.transform = `translateX(${-local * 160 * u}px)`;
          contents[i].style.transform = `translateX(${-local * 280 * u}px) translateY(${d * 24 * u}px)`;
          contents[i].style.opacity = String(Math.max(0, 1 - Math.abs(local) * 1.6));
        });
        setProgress(pos / last);
        setCurrent(Math.round(pos));
      } else {
        const y = (shown = scrollY);
        let i = 0;
        tops.forEach((top, t) => {
          if (y + vh / 2 >= top) i = t;
        });
        if (!reduce.matches) {
          // Parallax vertical del número gigante
          numbers.forEach((el, n) => {
            const local = (y - tops[n]) / vh;
            if (Math.abs(local) < 1.5) el.style.transform = `translateY(${local * 220}px)`;
          });
        }
        setProgress(clamp((y - tops[0]) / Math.max(1, tops[last] - tops[0])));
        setCurrent(i);
      }
    }

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    function setMode() {
      const next = desktop.matches && !reduce.matches ? 'horizontal' : 'vertical';
      if (next !== mode) {
        mode = next;
        root.dataset.mode = next;
        menu.hidden = next !== 'horizontal';
        mbar.hidden = next !== 'vertical';
        closeIndex(false);
        for (const el of [stage, track, ...numbers, ...winks, ...contents]) if (el) el.style.transform = el.style.opacity = '';
      }
      jump();
    }

    // Pinta ya la posición real, sin inercia (al cargar, al cambiar de modo o de tamaño).
    function jump() {
      cancelAnimationFrame(frame); // un solo bucle
      measure();
      shown = scrollY;
      lastTime = 0;
      update(performance.now());
    }

    // Escritorio: ir a una parada es desplazar el scroll real a su punto del imán, al instante.
    // La suavidad la pone la inercia, igual que con la rueda.
    const goToStop = (k: number) => scrollTo({ top: stopTop(k), behavior: 'instant' });
    const goTo = (i: number) => goToStop(i + 1);

    ticks.forEach((tick, i) => tick.addEventListener('click', () => goTo(i)));

    // "Desliza ↓": al capítulo 00, como los botones del menú.
    $('[data-to-start]').addEventListener('click', (event) => {
      if (mode !== 'horizontal') return;
      event.preventDefault();
      goTo(0);
    });

    // Con el foco (Tab) en algo que no se ve, se lleva a la vista su parada: portada, capítulo o cierre.
    const hero = $<HTMLElement>('.hero');
    const outro = $<HTMLElement>('.outro');
    root.addEventListener('focusin', (event) => {
      if (mode !== 'horizontal') return;
      const target = event.target as Node;
      const i = chapters.findIndex((c) => c.contains(target));
      const k = hero.contains(target) ? 0 : outro.contains(target) ? last + 2 : i >= 0 ? i + 1 : -1;
      if (k >= 0 && Math.abs(scrollY - stopTop(k)) > 1) goToStop(k);
    });

    // Anclas #capitulo-0X: en horizontal, al punto del recorrido.
    // Al cargar, directo; al pulsar un ancla ("Desliza ↓"), con la inercia.
    function followHash(initial = false) {
      const i = chapters.findIndex((c) => `#${c.id}` === location.hash);
      if (mode !== 'horizontal' || i < 0) return;
      goTo(i);
      if (initial) jump();
    }
    addEventListener('hashchange', () => followHash());

    // Móvil: índice desplegable
    function closeIndex(focus = true) {
      if (index.hidden) return;
      index.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      if (focus) toggle.focus();
    }

    toggle.addEventListener('click', () => {
      if (index.hidden) {
        index.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
      } else closeIndex();
    });
    index.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) closeIndex();
    });
    document.addEventListener('click', (event) => {
      if (!mbar.contains(event.target as Node)) closeIndex();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeIndex();
    });

    // Código Konami (solo escritorio): ↑ ↑ ↓ ↓ ← → ← → B A
    const sequence = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    const glyphs = $$<HTMLElement>('[data-glyph]');
    let step = 0;
    document.addEventListener('keydown', function konami(event) {
      if (!desktop.matches || (event.target as Element).closest?.('input, textarea')) return;
      const key = event.key?.length === 1 ? event.key.toLowerCase() : event.key;
      // Un error reinicia la secuencia, salvo un ↑ de más tras ↑↑, que mantiene el progreso.
      if (key === sequence[step]) step++;
      else if (key === 'ArrowUp') step = step === 2 ? 2 : 1;
      else step = 0;
      glyphs.forEach((g, i) => g.toggleAttribute('data-lit', i < step));
      if (step < sequence.length) return;
      document.removeEventListener('keydown', konami);
      root.toggleAttribute('data-konami-done', true);
      for (const el of $$('[data-level], [data-life]')) el.toggleAttribute('data-lit', true);
      $('[data-level]').textContent = '999';
      $<HTMLElement>('[data-bonus]').hidden = false;
      $('[data-konami-live]').textContent = root.dataset.konamiMessage!;
    });

    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', jump);
    desktop.addEventListener('change', setMode);
    reduce.addEventListener('change', setMode);
    setMode();
    followHash(true);
    // Las fuentes cambian las alturas: se vuelve a medir cuando cargan.
    document.fonts?.ready.then(jump);
  }
</script>

<style>
  .code {
    color: var(--accent);
  }

  .progress {
    display: flex;
    height: 1px;
    background: var(--line);
  }

  .progress span {
    flex: 1;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ——— Móvil: barra superior con índice ——— */
  .mbar {
    position: sticky;
    top: 0;
    z-index: 3;
    padding: env(safe-area-inset-top) var(--gutter-right) 0 var(--gutter-left);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .mbar[hidden] {
    display: none;
  }

  .mbar-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3.5rem;
  }

  .mbar-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap);
    margin-right: -0.5rem;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .chevron {
    display: inline-block;
    transition: transform var(--duration) ease;
  }

  [aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  .index {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 0.5rem 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    backdrop-filter: blur(12px);
  }

  .index[hidden] {
    display: none;
  }

  .index ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    min-height: 3.25rem;
    padding: 0.875rem 0.75rem;
    border-radius: var(--radius-md);
    color: var(--text-muted);
    text-decoration: none;
  }

  .index a[aria-current] {
    background: var(--surface);
    color: var(--text);
  }

  .index .code {
    width: 3.25rem;
    flex-shrink: 0;
    font-size: var(--fs-meta);
  }

  .index .name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1;
  }

  /* Sin scroll-margin: la barra se superpone al margen superior del capítulo (como en el diseño),
     así el contenido de cada capítulo cabe entero en pantalla al llegar con el índice o al deslizar. */

  /* ——— Escritorio: barra superior y menú, solo en horizontal ——— */
  .dbar,
  .menu,
  .snap {
    display: none;
  }

  /* Recorrido: una pantalla por parada (portada, 7 capítulos y cierre) */
  [data-mode='horizontal'] {
    position: relative;
    height: calc(9 * 100vh);
  }

  /* Imán: un marcador invisible por parada, en i × 100vh, del que no se puede pasar de largo */
  [data-mode='horizontal'] .snap {
    position: absolute;
    top: calc(var(--i) * 100vh);
    left: 0;
    width: 1px;
    height: 100vh;
    display: block;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    pointer-events: none;
  }

  [data-mode='horizontal'] .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: clip;
  }

  /* Escenario: portada, capítulos y cierre en columna, una pantalla cada uno; sube con la inercia */
  [data-mode='horizontal'] .stage {
    will-change: transform;
  }

  [data-mode='horizontal'] .view {
    position: relative;
    height: 100vh;
  }

  [data-mode='horizontal'] :global(:is(.hero, .outro)) {
    height: 100vh;
    min-height: 0;
  }

  [data-mode='horizontal'] .track {
    display: flex;
    width: calc(7 * 100vw);
    height: 100vh;
    will-change: transform;
  }

  [data-mode='horizontal'] :global(.chapter) {
    flex-shrink: 0;
    width: 100vw;
    height: 100vh;
    min-height: 0;
    padding-bottom: 9.375rem;
  }

  [data-mode='horizontal'] :global(.chapter[data-chapter='06']) {
    padding-top: 6.875rem;
    padding-bottom: 8.125rem;
  }

  [data-mode='horizontal'] :global(.chapter .number),
  [data-mode='horizontal'] :global(.chapter [data-wink]),
  [data-mode='horizontal'] :global(.chapter .content) {
    will-change: transform;
  }

  [data-mode='horizontal'] .dbar {
    position: absolute;
    top: 2rem;
    left: var(--gutter-left);
    right: var(--gutter-right);
    z-index: 2;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  [data-mode='horizontal'] .menu:not([hidden]) {
    position: absolute;
    left: calc(var(--gutter-left) - 0.75rem);
    right: calc(var(--gutter-right) - 0.75rem);
    bottom: 1.875rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .menu .progress {
    margin: 0 0.75rem;
  }

  .ticks {
    display: flex;
    justify-content: space-between;
  }

  .tick {
    position: relative;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0 0.75rem;
    border: 0;
    background: none;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    cursor: pointer;
    transition: color 300ms ease;
  }

  .tick[data-passed] {
    color: var(--accent);
  }

  .tick:hover {
    color: var(--text);
  }

  .tick-name {
    position: absolute;
    bottom: calc(100% + 0.75rem); /* separado de la línea de progreso */
    left: 0.75rem;
    font-family: var(--font-sans);
    white-space: nowrap;
    color: var(--text);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 200ms ease,
      transform 200ms ease;
    pointer-events: none;
  }

  .tick:hover .tick-name,
  .tick:focus-visible .tick-name {
    opacity: 1;
    transform: none;
  }

  /* Anclas de la portada ("Desliza ↓", índice de móvil) con desplazamiento suave. En horizontal no hace
     falta: la inercia suaviza todo lo que se pinta. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:has([data-timeline]:not([data-mode='horizontal']))) {
      scroll-behavior: smooth;
    }
  }

  /* Ajuste al desplazarse. En vertical (móvil, movimiento reducido o sin JS), suave, capítulo a capítulo.
     En horizontal, imán: siempre se para en la portada, en un capítulo (.snap), en el cierre o en el pie. */
  :global(html:has([data-timeline])) {
    scroll-snap-type: y proximity;
  }

  :global(html:has([data-timeline][data-mode='horizontal'])) {
    scroll-snap-type: y mandatory;
  }

  :global(html:has([data-timeline]) :is(.hero, .chapter, .outro)) {
    scroll-snap-align: start;
  }

  :global(html:has([data-timeline]) .site-footer) {
    scroll-snap-align: end;
  }

  /* En horizontal, todo está dentro del escenario anclado: el anclaje lo dan los marcadores. */
  [data-mode='horizontal'] :global(:is(.hero, .chapter, .outro)) {
    scroll-snap-align: none;
  }

  @media (max-width: 63.999rem) {
    :global(.chapter) {
      padding-bottom: calc(max(3rem, calc(env(safe-area-inset-bottom) + 1.5rem)) + var(--bars));
    }

    /* Con el chat abierto, sin ajuste: el teclado cambia el área visible y el ajuste podría
       devolver la página al inicio del capítulo, con el campo de texto debajo del teclado. */
    :global(html:has([data-chapter][data-chat-open])) {
      scroll-snap-type: none;
    }
  }
</style>
