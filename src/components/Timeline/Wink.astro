---
// Guiño visual de cada época. Decorativo: el contenido del capítulo no depende de él.
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';

interface Props {
  wink: NonNullable<CollectionEntry<'timeline'>['data']['wink']>;
  lang: Locale;
}

const { wink, lang } = Astro.props;
const ui = t(lang).home;

// Microservicios: posición [arriba, izquierda] en escritorio y en móvil (null = no cabe).
// En escritorio son px del diseño, sin unidad: el CSS los escala con --u.
const services: { name: string; desktop: [number, number]; mobile: [number, number] | null; main?: boolean }[] = [
  { name: 'users', desktop: [0, 0], mobile: [0, 0] },
  { name: 'orders', desktop: [70, 164], mobile: [52, 96] },
  { name: 'gateway', desktop: [-10, 334], mobile: [-4, 186], main: true },
  { name: 'auth', desktop: [110, 424], mobile: [108, 16] },
  { name: 'stock', desktop: [40, 544], mobile: [102, 206] },
  { name: 'billing', desktop: [130, 54], mobile: null },
];
const place = ([top, left]: [number, number], prefix: string, unit = '') => `--${prefix}t: ${top}${unit}; --${prefix}l: ${left}${unit};`;

// Código Konami: símbolos dispersos, con [izquierda, arriba, tamaño] en escritorio (sin unidad, como arriba) y en móvil.
// En escritorio se reparten con --u (como los números gigantes) y su tamaño crece con --u-detail.
const glyphs: { ch: string; desktop: [number, number, number]; mobile: [number, number, number] }[] = [
  { ch: '↑', desktop: [424, -24, 22], mobile: [226, 30, 16] },
  { ch: '↑', desktop: [516, 32, 16], mobile: [276, 72, 11] },
  { ch: '↓', desktop: [156, -28, 15], mobile: [38, 26, 10] },
  { ch: '↓', desktop: [374, 182, 26], mobile: [176, 148, 18] },
  { ch: '←', desktop: [54, 202, 18], mobile: [16, 164, 12] },
  { ch: '→', desktop: [464, 112, 14], mobile: [258, 134, 10] },
  { ch: '←', desktop: [266, 26, 18], mobile: [126, 54, 13] },
  { ch: '→', desktop: [546, 168, 20], mobile: [296, 184, 15] },
  { ch: 'B', desktop: [204, 214, 16], mobile: [86, 196, 10] },
  { ch: 'A', desktop: [590, -12, 24], mobile: [306, 22, 17] },
];
// Mando de videojuegos a trazos (00), en orden de trazado: [d, duración ms, retraso ms, opacidad].
// Contorno, segundo repaso tenue, cruceta, botones B y A, sus letras, select, start y cable.
const sketch: [string, number, number, number][] = [
  ['M 70 31 C 112 22, 208 21, 251 30 C 301 38, 313 91, 291 123 C 272 147, 235 141, 221 118 C 204 104, 116 105, 99 119 C 84 141, 47 146, 29 122 C 8 89, 21 39, 70 31', 845, 0, 0.9],
  ['M 72 34 C 114 25, 206 24, 248 33 C 296 41, 307 90, 287 120', 455, 585, 0.35],
  ['M 64 59 L 80 58 L 80 70 L 92 70 L 92 86 L 80 87 L 80 98 L 64 98 L 64 86 L 52 86 L 52 71 L 64 70 Z', 422, 878, 0.9],
  ['M 243 86 C 243 79, 238 75, 232 75 C 225 75, 221 80, 221 86 C 221 93, 226 97, 232 97 C 239 97, 243 92, 242 84', 247, 1332, 0.9],
  ['M 273 70 C 273 63, 268 59, 262 59 C 255 59, 251 64, 251 70 C 251 77, 256 81, 262 81 C 269 81, 273 76, 272 68', 247, 1592, 0.9],
  ['M 229 80 L 229 92 M 229 80 C 236 80, 236 86, 229 86 C 237 86, 237 92, 229 92', 195, 1852, 0.9],
  ['M 258 75 L 262 64 L 266 75 M 259.5 71 L 264.5 71', 195, 2048, 0.9],
  ['M 137 82 L 152 77', 130, 2242, 0.9],
  ['M 167 77 L 182 82', 130, 2372, 0.9],
  ['M 160 25 C 158 8, 182 -2, 206 6 C 224 12, 236 4, 244 -6', 455, 2502, 0.7],
];

const glyphStyle = ({ desktop: [dx, dy, ds], mobile: [mx, my, ms] }: (typeof glyphs)[number], i: number) =>
  `--i: ${i}; --dx: ${dx}; --dy: ${dy}; --ds: ${ds}; --mx: ${mx}px; --my: ${my}px; --ms: ${ms}px;`;
---

{wink === 'grid' && <div class="grid" data-wink="grid" aria-hidden="true" />}

{
  wink !== 'grid' && (
    <div class="wink" data-wink={wink} aria-hidden="true">
      {wink === 'level' && (
        <>
          <div class="hud">
            <span>
              {ui.level} <span class="level" data-level>00</span>
            </span>
            <span class="lives">
              <span />
              <span />
              <span />
              <span class="empty" data-life />
            </span>
            <span class="bonus" data-bonus hidden>+30</span>
          </div>
          <div class="glyphs">
            {glyphs.map((g, i) => (
              <span data-glyph style={glyphStyle(g, i)}>
                {g.ch}
              </span>
            ))}
          </div>
          <svg class="sketch" viewBox="0 0 320 160" fill="none" data-sketch>
            {sketch.map(([d, ms, delay, opacity]) => (
              <path d={d} pathLength="1" opacity={opacity} style={`--ms: ${ms}ms; --delay: ${delay}ms`} />
            ))}
          </svg>
        </>
      )}

      {wink === 'web2' && (
        <div class="accordion">
          <div class="acc-head open">
            <span>{ui.winks.accordion.open}</span>
            <span>▾</span>
          </div>
          <div class="acc-body">
            {ui.winks.accordion.links.map((link) => (
              <span>{link}</span>
            ))}
          </div>
          {ui.winks.accordion.closed.map((item) => (
            <div class="acc-head">
              <span>{item}</span>
              <span>▸</span>
            </div>
          ))}
        </div>
      )}

      {wink === 'mvc' && (
        <div class="mvc">
          <span>{ui.winks.model}</span>⇄<span class="main">{ui.winks.controller}</span>⇄<span>{ui.winks.view}</span>
        </div>
      )}

      {wink === 'services' && (
        <div class="services">
          {services.map((s) => (
            <span
              class:list={{ main: s.main, 'desktop-only': !s.mobile }}
              style={place(s.desktop, 'd') + (s.mobile ? place(s.mobile, 'm', 'px') : '')}
            >
              {s.name}
            </span>
          ))}
        </div>
      )}

      {wink === 'component' && (
        <div class="card">
          <span class="tag">&lt;Note /&gt;</span>
          <span class="title">{ui.winks.note}</span>
          <span class="chips">
            <span>UX</span>
            <span>DX</span>
          </span>
        </div>
      )}
    </div>
  )
}

<style>
  .wink {
    position: absolute;
    top: 5.5rem;
    left: var(--gutter-left);
    right: var(--gutter-right);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
    pointer-events: none;
  }

  /* 00 · Nivel y vidas, y un mando dibujado a trazos */
  .hud {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    letter-spacing: 0.25em;
  }

  .lives {
    display: flex;
    gap: 4px;
  }

  .lives span {
    width: 8px;
    height: 8px;
    background: var(--accent);
  }

  .lives .empty {
    border: 1px solid var(--line-dashed);
    background: none;
  }

  .level {
    transition: color 400ms ease;
  }

  .bonus {
    font-size: var(--fs-small);
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .bonus[hidden] {
    display: none;
  }

  /* Símbolos del Código Konami: se encienden al acertar la secuencia (ver Timeline.astro). */
  .glyphs span {
    position: absolute;
    left: var(--mx);
    top: var(--my);
    font-size: var(--ms);
    line-height: 1;
    color: var(--glyph);
  }

  /* Al acertar, cada símbolo se enciende y crece un poco (scale no choca con la ola final, que usa transform). */
  .glyphs span[data-lit] {
    color: var(--accent);
    scale: 1.3;
  }

  @media (prefers-reduced-motion: no-preference) {
    .glyphs span {
      transition:
        color 300ms ease,
        scale 300ms ease;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-konami-done]) .glyphs span {
      animation: wave 900ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 60ms);
    }
  }

  @keyframes wave {
    40% {
      transform: translateY(-5px);
    }
  }

  .lives .empty[data-lit] {
    border-color: var(--accent);
    background: var(--accent);
  }

  .level[data-lit] {
    color: var(--accent);
  }

  .sketch {
    display: block;
    width: 15rem;
    height: auto;
    margin-top: 0.75rem;
    overflow: visible;
  }

  .sketch path {
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Trazado: con JS, los trazos empiezan ocultos y se dibujan una sola vez cuando el script marca
     data-drawn (ver Timeline.astro). Sin JS o con movimiento reducido, el dibujo se ve completo. */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-sketch-ready]) .sketch path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    :global([data-sketch-ready]) .sketch[data-drawn] path {
      animation: draw var(--ms) cubic-bezier(0.45, 0.05, 0.35, 1) var(--delay) forwards;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* 01 · Retícula de tablas */
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 78px 40px;
    pointer-events: none;
  }

  /* 02 · Menú acordeón de jQuery: lo que hace el slideToggle() del capítulo */
  .accordion {
    display: flex;
    flex-direction: column;
    width: 12.5rem;
    border: 1px solid var(--web2-border);
    background: var(--web2-bg);
    font-family: var(--font-verdana);
    font-size: 0.6875rem;
    color: var(--web2-text);
  }

  .acc-head {
    display: flex;
    justify-content: space-between;
    padding: 0.375rem 0.625rem;
    background: var(--web2-bar-closed);
    font-weight: 700;
  }

  .acc-head,
  .acc-body {
    border-bottom: 1px solid var(--web2-border);
  }

  .accordion > :last-child {
    border-bottom: 0;
  }

  .acc-head.open {
    background: var(--web2-bar);
  }

  .acc-body {
    display: flex;
    flex-direction: column;
    padding: 0.3125rem 0.625rem 0.4375rem 1.25rem;
    line-height: 1.9;
  }

  .acc-body span {
    color: var(--web2-link);
    text-decoration: underline;
  }

  /* 03 · Modelo ⇄ Controlador ⇄ Vista */
  .mvc {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mvc span {
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--line-muted);
  }

  .mvc .main {
    border-color: var(--accent);
    color: var(--text);
  }

  /* 04 · Servicios sueltos alrededor de un gateway */
  .services {
    position: relative;
  }

  .services span {
    position: absolute;
    top: var(--mt);
    left: var(--ml);
    padding: 0.5rem 0.75rem;
    border: 1px dashed var(--line-dashed);
    border-radius: var(--radius-sm);
  }

  .services .main {
    border: 1px solid var(--accent);
    color: var(--text);
  }

  .services .desktop-only {
    display: none;
  }

  /* 05 · Tarjeta de componente */
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 17.5rem;
    padding: 1.125rem;
    border-radius: 1rem;
    background: var(--paper);
    box-shadow: 0 24px 60px var(--paper-shadow);
    font-family: var(--font-sans);
    color: var(--paper-text);
  }

  .card .tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--paper-muted);
  }

  .card .title {
    font-size: 1.125rem;
    font-weight: 500;
  }

  .chips {
    display: flex;
    gap: 0.5rem;
  }

  .chips span {
    padding: 0.1875rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--paper-chip);
    font-size: 0.6875rem;
  }

  /* Escritorio: medidas del diseño a 1280×800, escaladas con --u-detail (crecen la mitad que --u). */
  @media (min-width: 64rem) {
    /* Origen de los guiños: el margen del texto y 120px desde arriba (docs/diseno.md) */
    .wink {
      top: 7.5rem;
      font-size: calc(13 * var(--u-detail));
    }

    .hud {
      gap: calc(16 * var(--u-detail));
    }

    .lives {
      gap: calc(4 * var(--u-detail));
    }

    .lives span {
      width: calc(10 * var(--u-detail));
      height: calc(10 * var(--u-detail));
    }

    .bonus {
      font-size: calc(12 * var(--u-detail));
    }

    .sketch {
      position: absolute;
      top: calc(40 * var(--u-detail));
      left: 0;
      width: calc(320 * var(--u-detail));
      height: calc(160 * var(--u-detail));
      margin: 0;
    }

    .glyphs span {
      left: calc(var(--dx) * var(--u));
      top: calc(var(--dy) * var(--u));
      font-size: calc(var(--ds) * var(--u-detail));
    }

    /* Más ancha que el capítulo: el parallax la desplaza sin dejar bordes vacíos. */
    .grid {
      left: calc(-320 * var(--u));
      right: calc(-320 * var(--u));
      background-size: calc(160 * var(--u-detail)) calc(80 * var(--u-detail));
    }

    .accordion {
      width: calc(240 * var(--u-detail));
      font-size: calc(12 * var(--u-detail));
    }

    .acc-head {
      padding: calc(7 * var(--u-detail)) calc(12 * var(--u-detail));
    }

    .acc-body {
      padding: calc(6 * var(--u-detail)) calc(12 * var(--u-detail)) calc(8 * var(--u-detail)) calc(24 * var(--u-detail));
    }

    .mvc {
      gap: calc(16 * var(--u-detail));
      font-size: calc(14 * var(--u-detail));
    }

    .mvc span {
      padding: calc(18 * var(--u-detail)) calc(28 * var(--u-detail));
    }

    .services span {
      top: calc(var(--dt) * var(--u-detail));
      left: calc(var(--dl) * var(--u-detail));
      padding: calc(10 * var(--u-detail)) calc(16 * var(--u-detail));
      border-radius: calc(4 * var(--u-detail));
    }

    .services .desktop-only {
      display: block;
    }

    .card {
      gap: calc(10 * var(--u-detail));
      width: calc(340 * var(--u-detail));
      padding: calc(22 * var(--u-detail));
      border-radius: calc(16 * var(--u-detail));
      box-shadow: 0 calc(24 * var(--u-detail)) calc(60 * var(--u-detail)) var(--paper-shadow);
    }

    .card .tag {
      font-size: calc(12 * var(--u-detail));
    }

    .card .title {
      font-size: calc(20 * var(--u-detail));
    }

    .chips {
      gap: calc(8 * var(--u-detail));
    }

    .chips span {
      padding: calc(4 * var(--u-detail)) calc(12 * var(--u-detail));
      font-size: calc(12 * var(--u-detail));
    }
  }
</style>
