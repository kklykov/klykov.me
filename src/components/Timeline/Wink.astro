---
// Guiño visual de cada época. Decorativo: el contenido del capítulo no depende de él.
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';

interface Props {
  wink: NonNullable<CollectionEntry<'timeline'>['data']['wink']>;
  lang: Locale;
}

const { wink, lang } = Astro.props;
const ui = t(lang).home;

// Microservicios: posición [arriba, izquierda] en escritorio y en móvil (null = no cabe).
// En escritorio son px del diseño, sin unidad: el CSS los escala con --u.
const services: { name: string; desktop: [number, number]; mobile: [number, number] | null; main?: boolean }[] = [
  { name: 'users', desktop: [0, 0], mobile: [0, 0] },
  { name: 'orders', desktop: [70, 164], mobile: [52, 96] },
  { name: 'gateway', desktop: [-10, 334], mobile: [-4, 186], main: true },
  { name: 'auth', desktop: [110, 424], mobile: [108, 16] },
  { name: 'stock', desktop: [40, 544], mobile: [102, 206] },
  { name: 'billing', desktop: [130, 54], mobile: null },
];
const place = ([top, left]: [number, number], prefix: string, unit = '') => `--${prefix}t: ${top}${unit}; --${prefix}l: ${left}${unit};`;

// Código Konami: símbolos dispersos, con [izquierda, arriba, tamaño] en escritorio (sin unidad, como arriba) y en móvil.
const glyphs: { ch: string; desktop: [number, number, number]; mobile: [number, number, number] }[] = [
  { ch: '↑', desktop: [424, -24, 22], mobile: [226, 30, 16] },
  { ch: '↑', desktop: [516, 32, 13], mobile: [276, 72, 11] },
  { ch: '↓', desktop: [156, -28, 12], mobile: [38, 26, 10] },
  { ch: '↓', desktop: [374, 182, 26], mobile: [176, 148, 18] },
  { ch: '←', desktop: [54, 202, 16], mobile: [16, 164, 12] },
  { ch: '→', desktop: [464, 112, 11], mobile: [258, 134, 10] },
  { ch: '←', desktop: [266, 26, 18], mobile: [126, 54, 13] },
  { ch: '→', desktop: [546, 168, 20], mobile: [296, 184, 15] },
  { ch: 'B', desktop: [204, 214, 13], mobile: [86, 196, 10] },
  { ch: 'A', desktop: [590, -12, 24], mobile: [306, 22, 17] },
];
const glyphStyle = ({ desktop: [dx, dy, ds], mobile: [mx, my, ms] }: (typeof glyphs)[number], i: number) =>
  `--i: ${i}; --dx: ${dx}; --dy: ${dy}; --ds: ${ds}; --mx: ${mx}px; --my: ${my}px; --ms: ${ms}px;`;
---

{wink === 'grid' && <div class="grid" data-wink="grid" aria-hidden="true" />}

{
  wink !== 'grid' && (
    <div class="wink" data-wink={wink} aria-hidden="true">
      {wink === 'level' && (
        <>
          <div class="hud">
            <span>
              {ui.level} <span class="level" data-level>00</span>
            </span>
            <span class="lives">
              <span />
              <span />
              <span />
              <span class="empty" data-life />
            </span>
            <span class="bonus" data-bonus hidden>+30</span>
          </div>
          <div class="glyphs">
            {glyphs.map((g, i) => (
              <span data-glyph style={glyphStyle(g, i)}>
                {g.ch}
              </span>
            ))}
          </div>
          <svg class="squiggle" viewBox="0 0 420 120" fill="none">
            <path d="M4 90 C 60 20, 110 110, 170 60 S 280 10, 330 70 S 400 100, 416 40" />
          </svg>
        </>
      )}

      {wink === 'web2' && (
        <div class="web2-box">
          <div class="web2-bar">{ui.winks.news}</div>
          <div class="web2-body">
            {ui.winks.rounded} <span>{ui.winks.readMore}</span>
          </div>
        </div>
      )}

      {wink === 'mvc' && (
        <div class="mvc">
          <span>{ui.winks.model}</span>⇄<span class="main">{ui.winks.controller}</span>⇄<span>{ui.winks.view}</span>
        </div>
      )}

      {wink === 'services' && (
        <div class="services">
          {services.map((s) => (
            <span
              class:list={{ main: s.main, 'desktop-only': !s.mobile }}
              style={place(s.desktop, 'd') + (s.mobile ? place(s.mobile, 'm', 'px') : '')}
            >
              {s.name}
            </span>
          ))}
        </div>
      )}

      {wink === 'component' && (
        <div class="card">
          <span class="tag">&lt;Note /&gt;</span>
          <span class="title">{ui.winks.note}</span>
          <span class="chips">
            <span>UX</span>
            <span>DX</span>
          </span>
        </div>
      )}
    </div>
  )
}

<style>
  .wink {
    position: absolute;
    top: 5.5rem;
    left: var(--gutter-left);
    right: var(--gutter-right);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
    pointer-events: none;
  }

  /* 00 · Nivel y vidas, y un garabato de lápiz */
  .hud {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    letter-spacing: 0.25em;
  }

  .lives {
    display: flex;
    gap: 4px;
  }

  .lives span {
    width: 8px;
    height: 8px;
    background: var(--accent);
  }

  .lives .empty {
    border: 1px solid var(--line-dashed);
    background: none;
  }

  .level {
    transition: color 400ms ease;
  }

  .bonus {
    font-size: var(--fs-small);
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .bonus[hidden] {
    display: none;
  }

  /* Símbolos del Código Konami: se encienden al acertar la secuencia (ver Timeline.astro). */
  .glyphs span {
    position: absolute;
    left: var(--mx);
    top: var(--my);
    font-size: var(--ms);
    line-height: 1;
    color: var(--glyph);
    transition: color 400ms ease;
  }

  .glyphs span[data-lit] {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-konami-done]) .glyphs span {
      animation: wave 900ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 60ms);
    }
  }

  @keyframes wave {
    40% {
      transform: translateY(-5px);
    }
  }

  .lives .empty[data-lit] {
    border-color: var(--accent);
    background: var(--accent);
  }

  .level[data-lit] {
    color: var(--accent);
  }

  .squiggle {
    width: 18.75rem;
    margin-top: 1rem;
  }

  .squiggle path {
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0.7;
  }

  /* 01 · Retícula de tablas */
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 78px 40px;
    pointer-events: none;
  }

  /* 02 · Caja Web 2.0 */
  .web2-box {
    width: 16.25rem;
    border: 1px solid var(--web2-border);
    border-radius: 6px;
    background: var(--web2-bg);
    font-family: var(--font-verdana);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--web2-text);
  }

  .web2-bar {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--web2-border);
    border-radius: 6px 6px 0 0;
    background: var(--web2-bar);
    font-weight: 700;
  }

  .web2-body {
    padding: 0.625rem 0.75rem;
  }

  .web2-body span {
    color: var(--web2-link);
  }

  /* 03 · Modelo ⇄ Controlador ⇄ Vista */
  .mvc {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mvc span {
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--line-muted);
  }

  .mvc .main {
    border-color: var(--accent);
    color: var(--text);
  }

  /* 04 · Servicios sueltos alrededor de un gateway */
  .services {
    position: relative;
  }

  .services span {
    position: absolute;
    top: var(--mt);
    left: var(--ml);
    padding: 0.5rem 0.75rem;
    border: 1px dashed var(--line-dashed);
    border-radius: var(--radius-sm);
  }

  .services .main {
    border: 1px solid var(--accent);
    color: var(--text);
  }

  .services .desktop-only {
    display: none;
  }

  /* 05 · Tarjeta de componente */
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 17.5rem;
    padding: 1.125rem;
    border-radius: 1rem;
    background: var(--paper);
    box-shadow: 0 24px 60px var(--paper-shadow);
    font-family: var(--font-sans);
    color: var(--paper-text);
  }

  .card .tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--paper-muted);
  }

  .card .title {
    font-size: 1.125rem;
    font-weight: 500;
  }

  .chips {
    display: flex;
    gap: 0.5rem;
  }

  .chips span {
    padding: 0.1875rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--paper-chip);
    font-size: 0.6875rem;
  }

  /* Escritorio: medidas del diseño a 1280×800, escaladas con --u-detail (crecen la mitad que --u). */
  @media (min-width: 64rem) {
    .wink {
      top: calc(120 * var(--u-detail));
      font-size: calc(13 * var(--u-detail));
    }

    .hud {
      gap: calc(16 * var(--u-detail));
    }

    .lives {
      gap: calc(4 * var(--u-detail));
    }

    .lives span {
      width: calc(10 * var(--u-detail));
      height: calc(10 * var(--u-detail));
    }

    .bonus {
      font-size: calc(12 * var(--u-detail));
    }

    .squiggle {
      width: calc(420 * var(--u-detail));
      margin-top: calc(16 * var(--u-detail));
    }

    .glyphs span {
      left: calc(var(--dx) * var(--u-detail));
      top: calc(var(--dy) * var(--u-detail));
      font-size: calc(var(--ds) * var(--u-detail));
    }

    .squiggle path {
      stroke-width: 2;
    }

    /* Más ancha que el capítulo: el parallax la desplaza sin dejar bordes vacíos. */
    .grid {
      left: calc(-320 * var(--u));
      right: calc(-320 * var(--u));
      background-size: calc(160 * var(--u-detail)) calc(80 * var(--u-detail));
    }

    .web2-box {
      width: calc(320 * var(--u-detail));
      border-radius: calc(6 * var(--u-detail));
      font-size: calc(12 * var(--u-detail));
    }

    .web2-bar {
      padding: calc(8 * var(--u-detail)) calc(12 * var(--u-detail));
      border-radius: calc(6 * var(--u-detail)) calc(6 * var(--u-detail)) 0 0;
    }

    .web2-body {
      padding: calc(12 * var(--u-detail));
    }

    .mvc {
      gap: calc(16 * var(--u-detail));
      font-size: calc(14 * var(--u-detail));
    }

    .mvc span {
      padding: calc(18 * var(--u-detail)) calc(28 * var(--u-detail));
    }

    .services span {
      top: calc(var(--dt) * var(--u-detail));
      left: calc(var(--dl) * var(--u-detail));
      padding: calc(10 * var(--u-detail)) calc(16 * var(--u-detail));
      border-radius: calc(4 * var(--u-detail));
    }

    .services .desktop-only {
      display: block;
    }

    .card {
      gap: calc(10 * var(--u-detail));
      width: calc(340 * var(--u-detail));
      padding: calc(22 * var(--u-detail));
      border-radius: calc(16 * var(--u-detail));
      box-shadow: 0 calc(24 * var(--u-detail)) calc(60 * var(--u-detail)) var(--paper-shadow);
    }

    .card .tag {
      font-size: calc(12 * var(--u-detail));
    }

    .card .title {
      font-size: calc(20 * var(--u-detail));
    }

    .chips {
      gap: calc(8 * var(--u-detail));
    }

    .chips span {
      padding: calc(4 * var(--u-detail)) calc(12 * var(--u-detail));
      font-size: calc(12 * var(--u-detail));
    }
  }
</style>
