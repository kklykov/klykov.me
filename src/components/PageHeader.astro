---
// Cabecera de las páginas de sección: metadatos, título grande con el punto
// en el color de acento, entradilla y, debajo, lo que se pase en el slot "after".
interface Props {
  intro?: string;
}

const { intro } = Astro.props;
---

<div class="page-header">
  {Astro.slots.has('meta') && <p class="meta"><slot name="meta" /></p>}
  <h1><slot /><span class="dot">.</span></h1>
  {intro && <p class="intro">{intro}</p>}
  <slot name="after" />
</div>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 1.0309rem + 0.8989vw, 1.75rem); /* 20 → 28 */
    padding-top: clamp(2.5rem, 1.6236rem + 3.5955vw, 4.5rem); /* 40 → 72 */
    padding-bottom: clamp(2rem, 1.5618rem + 1.7978vw, 3rem); /* 32 → 48 */
    padding-inline: var(--gutter-left) var(--gutter-right);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--text-muted);
  }

  h1 {
    font-size: var(--fs-display);
    line-height: 0.85;
    letter-spacing: -0.03em;
  }

  .dot {
    color: var(--accent);
  }

  .intro {
    max-width: 35rem;
    font-size: clamp(1.0625rem, 0.9803rem + 0.3371vw, 1.25rem); /* 17 → 20 */
    line-height: 1.55;
    color: var(--text-muted);
  }
</style>
