---
import { getCollection } from 'astro:content';
import Hero from '../../components/Timeline/Hero.astro';
import Outro from '../../components/Timeline/Outro.astro';
import Timeline from '../../components/Timeline/Timeline.astro';
import Base from '../../layouts/Base.astro';
import { locales, type Locale } from '../../i18n/config';
import { alternatesFor } from '../../i18n/routes';
import { t } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const ui = t(lang).home;
const alternates = alternatesFor(Astro.url.pathname);
const chapters = (await getCollection('timeline')).sort((a, b) => a.id.localeCompare(b.id));
---

<Base title="klykov.me" description={ui.intro} alternates={alternates} header={false}>
  <Hero lang={lang} alternates={alternates} />
  <Timeline chapters={chapters} lang={lang} />
  <Outro lang={lang} />
</Base>
